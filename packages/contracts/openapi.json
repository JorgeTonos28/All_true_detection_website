  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token Sanctum de cliente verificado, activo y con scopes limitados."
      }
    },
    "schemas": {
      "OrderStatus": {
        "type": "string",
        "enum": [
          "submitted",
          "reviewing",
          "quoted",
          "in_progress",
          "completed",
          "cancelled"
        ]
      },
      "Service": {
        "type": "object",
        "required": [
          "code",
          "name",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CreateOrder": {
        "type": "object",
        "required": [
          "subject",
          "details",
          "consent",
          "items"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 200
          },
          "details": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10000
          },
          "external_reference": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 11,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "service_code",
                "quantity"
              ],
              "properties": {
                "service_code": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
